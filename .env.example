# ============================================================================
# Variables de entorno de Tiendas Big Bang
# ============================================================================
# Copia este archivo a .env.local y llena los valores reales.
# NUNCA subas .env.local al repo (.gitignore ya lo excluye).
#
# Convencion de Next.js:
#   NEXT_PUBLIC_* -> expuestas al navegador
#   sin prefijo   -> solo server (route handlers, server components, actions)
# ============================================================================

# --- Proxy del catalogo (droplet en DigitalOcean con la BD del ERP) ---------
# La API key JAMAS lleva el prefijo NEXT_PUBLIC_. Si se cuela al navegador
# hay que rotarla en el droplet.
CATALOGO_API_BASE=https://api.tiendasbigbang.com
CATALOGO_API_KEY=

# --- Supabase (proyecto bigbang-ecommerce) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://rzhzuvmrnfuctwyunhiu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La service role solo se usa en el servidor para pedidos y para llamar la
# funcion SQL generate_numero_pedido(). Nunca la expongas.
SUPABASE_SERVICE_ROLE_KEY=

# --- ePayco (pasarela de pagos) --------------------------------------------
# Pendientes hasta que el cliente termine de crear la cuenta.
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_TEST_MODE=true

# --- Dominio publico -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tiendasbigbang.com

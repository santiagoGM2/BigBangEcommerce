# ============================================================================
# Variables de entorno de Tiendas Big Bang
# ============================================================================
# Copia este archivo a .env.local y llena los valores reales.
# NUNCA subas .env.local al repo (.gitignore ya lo excluye).
#
# Convencion de Next.js:
#   NEXT_PUBLIC_* -> expuestas al navegador
#   sin prefijo   -> solo server (route handlers, server components, actions)
# ============================================================================

# --- Proxy del catalogo (droplet en DigitalOcean con la BD del ERP) ---------
# La API key JAMAS lleva el prefijo NEXT_PUBLIC_. Si se cuela al navegador
# hay que rotarla en el droplet.
CATALOGO_API_BASE=https://api.tiendasbigbang.com
CATALOGO_API_KEY=

# --- Supabase (proyecto bigbang-ecommerce) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://rzhzuvmrnfuctwyunhiu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La service role administra pedidos y fotos desde el servidor/importadores.
# Nunca la expongas al navegador ni la compartas con el equipo de marketing.
SUPABASE_SERVICE_ROLE_KEY=

# Acceso privado a la confirmacion: secreto independiente de al menos 32 caracteres.
# Opcional: sin el, se usa la service role para HMAC con un contexto exclusivo.
# La autorizacion dura siete dias y usa una cookie del mismo navegador.
# Un numero de pedido o una URL antigua por si solos no autorizan el acceso.
ORDER_ACCESS_SECRET=

# --- ePayco (pasarela de pagos) --------------------------------------------
# Pendientes hasta que el cliente termine de crear la cuenta.
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_TEST_MODE=true

# --- Dominio publico -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tiendasbigbang.com

# ERP: configuracion privada para reconstruccion y diagnostico
ERP_DB_HOST=
ERP_DB_PORT=
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_NAME=
ERP_DB_VIEW=
ERP_DB_CA_PATH=
ERP_DB_ALLOW_PLAINTEXT=false

# Administracion por SSH (solo operaciones manuales, nunca el navegador).
# Usuario@host y ruta absoluta de la llave autorizada. No guardar la llave en Git.
ERP_PROXY_SSH_TARGET=
ERP_PROXY_SSH_KEY_PATH=

# Fotos de Drive: acceso lector con identidad federada temporal
GOOGLE_DRIVE_FOLDER_ID=15Nz_GHOOKbfw04s1abKMjSRzQ8RSlBjt


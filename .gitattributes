# Mismo contenido entre Windows, Linux y CI.
* text=auto eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
# Los espacios en líneas de contexto vacías son parte del formato de parche.
*.patch text eol=lf whitespace=-blank-at-eol
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

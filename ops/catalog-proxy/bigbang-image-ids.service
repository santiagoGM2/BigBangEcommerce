[Unit]
Description=Tiendas Big Bang - identificadores ERP para fotos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bigbang
Group=bigbang
ExecStart=/usr/bin/python3 /opt/bigbang/image_ids_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
TasksMax=24
UMask=0077

[Install]
WantedBy=multi-user.target
